      "inventory_status": "ready"
    },
    {
      "id": "diet-unmeetable",
      "dish": "miso_soup", "qty": 1,
      "text": "is this vegan? I need it vegan",
      "expected": {"ops": [], "flags": {"level": "diet", "allergens": [], "diets": ["vegan"]}},
      "inventory_status": "unavailable",
      "why": "The broth has bonito (fish) and no approved swap."
    },
    {
      "id": "qty-from-ui",
      "dish": "miso_soup", "qty": 2,
      "text": "extra tofu in both",
      "expected": {"ops": [{"op": "add", "ingredient": "tofu", "qty": 1}], "flags": null},
      "inventory_status": "ready",
      "why": "Quantity comes from the UI; 'in both' doesn't change the extra count per bowl."
    }
  ]
}
