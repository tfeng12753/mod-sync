# Reference only — set these as environment variables (never commit a real .env).
OPENROUTER_API_KEY=
# OpenRouter model that supports structured (json_schema) outputs.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Exact menu commands use the catalog alias index; complex requests use the configured model.
PARSER_FAST_PATH_ENABLED=1
# Validated model parses only: up to 256 entries, 10-minute TTL, in memory per process.
PARSER_CACHE_ENABLED=1
# Docker sets this automatically for the combined UI/API deployment.
# FRONTEND_DIST=/app/frontend/dist
