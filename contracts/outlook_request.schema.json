{
  "$defs": {
    "ForecastRequest": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "time_zone": {
          "title": "Time Zone",
          "type": "string"
        },
        "daypart": {
          "minLength": 1,
          "title": "Daypart",
          "type": "string"
        },
        "ingredients": {
          "items": {
            "$ref": "#/$defs/Ingredient"
          },
          "minItems": 1,
          "title": "Ingredients",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/UsageRecord"
          },
          "title": "History",
          "type": "array"
        },
        "source": {
          "default": "measured",
          "enum": [
            "measured",
            "recipe_estimated"
          ],
          "title": "Source",
          "type": "string"
        },
        "lookback_days": {
          "default": 90,
          "maximum": 730,
          "minimum": 1,
          "title": "Lookback Days",
          "type": "integer"
        },
        "half_life_days": {
          "default": 28,
          "exclusiveMinimum": 0,
          "title": "Half Life Days",
          "type": "number"
        },
        "minimum_comparable_periods": {
          "default": 3,
          "minimum": 2,
          "title": "Minimum Comparable Periods",
          "type": "integer"
        },
        "model": {
          "default": "autoets",
          "enum": [
            "autoets",
            "historical"
          ],
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "time_zone",
        "daypart",
        "ingredients",
        "history"
      ],
      "title": "ForecastRequest",
      "type": "object"
    },
    "Ingredient": {
      "additionalProperties": false,
      "properties": {
        "ingredient_id": {
          "minLength": 1,
          "title": "Ingredient Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "each"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "ingredient_id",
        "unit"
      ],
      "title": "Ingredient",
      "type": "object"
    },
    "InventoryPosition": {
      "additionalProperties": false,
      "properties": {
        "ingredient_id": {
          "minLength": 1,
          "title": "Ingredient Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "each"
          ],
          "title": "Unit",
          "type": "string"
        },
        "available_now": {
          "minimum": 0,
          "title": "Available Now",
          "type": "number"
        },
        "committed_in_horizon": {
          "minimum": 0,
          "title": "Committed In Horizon",
          "type": "number"
        }
      },
      "required": [
        "ingredient_id",
        "unit",
        "available_now",
        "committed_in_horizon"
      ],
      "title": "InventoryPosition",
      "type": "object"
    },
    "InventorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/InventoryPosition"
          },
          "title": "Positions",
          "type": "array"
        },
        "commitments_known": {
          "default": true,
          "title": "Commitments Known",
          "type": "boolean"
        },
        "version_is_authoritative": {
          "default": true,
          "title": "Version Is Authoritative",
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "as_of",
        "valid_until",
        "positions"
      ],
      "title": "InventorySnapshot",
      "type": "object"
    },
    "Restriction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "allergy",
            "dietary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "staff_review_note": {
          "default": "",
          "maxLength": 2000,
          "title": "Staff Review Note",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Restriction",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "ingredient_id": {
          "minLength": 1,
          "title": "Ingredient Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "each"
          ],
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "daypart": {
          "minLength": 1,
          "title": "Daypart",
          "type": "string"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "source": {
          "enum": [
            "measured",
            "recipe_estimated"
          ],
          "title": "Source",
          "type": "string"
        },
        "stockout": {
          "default": false,
          "title": "Stockout",
          "type": "boolean"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        }
      },
      "required": [
        "ingredient_id",
        "unit",
        "start",
        "end",
        "daypart",
        "quantity",
        "source"
      ],
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "forecast": {
      "$ref": "#/$defs/ForecastRequest"
    },
    "inventory": {
      "$ref": "#/$defs/InventorySnapshot"
    },
    "max_snapshot_age_seconds": {
      "default": 300,
      "minimum": 1,
      "title": "Max Snapshot Age Seconds",
      "type": "integer"
    },
    "restrictions": {
      "items": {
        "$ref": "#/$defs/Restriction"
      },
      "title": "Restrictions",
      "type": "array"
    },
    "staff_review_notes": {
      "items": {
        "type": "string"
      },
      "title": "Staff Review Notes",
      "type": "array"
    }
  },
  "required": [
    "evaluated_at",
    "forecast",
    "inventory"
  ],
  "title": "OutlookRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
