{
  "$defs": {
    "DecisionFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "text"
      ],
      "title": "DecisionFact",
      "type": "object"
    },
    "ForecastResult": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "daypart": {
          "title": "Daypart",
          "type": "string"
        },
        "forecasts": {
          "items": {
            "$ref": "#/$defs/IngredientForecast"
          },
          "title": "Forecasts",
          "type": "array"
        }
      },
      "required": [
        "start",
        "end",
        "daypart",
        "forecasts"
      ],
      "title": "ForecastResult",
      "type": "object"
    },
    "IngredientForecast": {
      "additionalProperties": false,
      "properties": {
        "ingredient_id": {
          "minLength": 1,
          "title": "Ingredient Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "each"
          ],
          "title": "Unit",
          "type": "string"
        },
        "expected_usage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Usage"
        },
        "uncertainty_buffer": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty Buffer"
        },
        "method": {
          "enum": [
            "same_weekday_daypart",
            "daypart_fallback",
            "insufficient_history"
          ],
          "title": "Method",
          "type": "string"
        },
        "source": {
          "enum": [
            "measured",
            "recipe_estimated"
          ],
          "title": "Source",
          "type": "string"
        },
        "sample_count": {
          "title": "Sample Count",
          "type": "integer"
        },
        "backtest_count": {
          "title": "Backtest Count",
          "type": "integer"
        },
        "backtest_mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Backtest Mae"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "model": {
          "default": "historical",
          "enum": [
            "autoets",
            "historical",
            "unknown"
          ],
          "title": "Model",
          "type": "string"
        },
        "baseline_backtest_mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Backtest Mae"
        },
        "autoets_backtest_mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autoets Backtest Mae"
        }
      },
      "required": [
        "ingredient_id",
        "unit",
        "expected_usage",
        "uncertainty_buffer",
        "method",
        "source",
        "sample_count",
        "backtest_count",
        "backtest_mae",
        "warnings"
      ],
      "title": "IngredientForecast",
      "type": "object"
    },
    "IngredientTradeoff": {
      "additionalProperties": false,
      "properties": {
        "ingredient_id": {
          "minLength": 1,
          "title": "Ingredient Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "each"
          ],
          "title": "Unit",
          "type": "string"
        },
        "requested_quantity": {
          "title": "Requested Quantity",
          "type": "number"
        },
        "available_after_commitments": {
          "title": "Available After Commitments",
          "type": "number"
        },
        "uncommitted_expected_demand": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncommitted Expected Demand"
        },
        "uncertainty_buffer": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty Buffer"
        },
        "projected_surplus": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Projected Surplus"
        },
        "reserve_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reserve Score"
        }
      },
      "required": [
        "ingredient_id",
        "unit",
        "requested_quantity",
        "available_after_commitments",
        "uncommitted_expected_demand",
        "uncertainty_buffer",
        "projected_surplus",
        "reserve_score"
      ],
      "title": "IngredientTradeoff",
      "type": "object"
    },
    "RankedOption": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "title": "Option Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "requires_staff_review": {
          "title": "Requires Staff Review",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "tradeoffs": {
          "items": {
            "$ref": "#/$defs/IngredientTradeoff"
          },
          "title": "Tradeoffs",
          "type": "array"
        },
        "ingredient_cost_change_cents": {
          "title": "Ingredient Cost Change Cents",
          "type": "integer"
        },
        "additional_labor_cents": {
          "title": "Additional Labor Cents",
          "type": "integer"
        },
        "price_change_cents": {
          "title": "Price Change Cents",
          "type": "integer"
        },
        "factors": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Factors",
          "type": "object"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/DecisionFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "staff_review_notes": {
          "items": {
            "type": "string"
          },
          "title": "Staff Review Notes",
          "type": "array"
        },
        "similarity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity"
        },
        "similarity_source": {
          "default": "inventory",
          "enum": [
            "inventory",
            "supplied",
            "not_applicable",
            "unavailable"
          ],
          "title": "Similarity Source",
          "type": "string"
        },
        "similarity_rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Rationale"
        },
        "blocked_by_restriction": {
          "default": false,
          "title": "Blocked By Restriction",
          "type": "boolean"
        }
      },
      "required": [
        "option_id",
        "label",
        "score",
        "eligible",
        "requires_staff_review",
        "reasons",
        "tradeoffs",
        "ingredient_cost_change_cents",
        "additional_labor_cents",
        "price_change_cents",
        "factors",
        "facts",
        "explanation"
      ],
      "title": "RankedOption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "inventory_version": {
      "title": "Inventory Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "needs_customer_approval",
        "needs_staff_review",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "recommended_option_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recommended Option Id"
    },
    "forecasts": {
      "$ref": "#/$defs/ForecastResult"
    },
    "ranked_options": {
      "items": {
        "$ref": "#/$defs/RankedOption"
      },
      "title": "Ranked Options",
      "type": "array"
    },
    "excluded_options": {
      "items": {
        "$ref": "#/$defs/RankedOption"
      },
      "title": "Excluded Options",
      "type": "array"
    },
    "review_options": {
      "items": {
        "$ref": "#/$defs/RankedOption"
      },
      "title": "Review Options",
      "type": "array"
    },
    "staff_review_notes": {
      "items": {
        "type": "string"
      },
      "title": "Staff Review Notes",
      "type": "array"
    },
    "explanation_source": {
      "default": "deterministic",
      "enum": [
        "deterministic",
        "openrouter"
      ],
      "title": "Explanation Source",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "inventory_version",
    "status",
    "recommended_option_id",
    "forecasts",
    "ranked_options",
    "excluded_options"
  ],
  "title": "EvaluationResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
